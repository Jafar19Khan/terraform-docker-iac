# ---------------------------------------------------------------------------
# Terraform + Docker: provision a local Docker container with Infrastructure as Code
#
# Resources created (in dependency order):
#   1. docker_image.nginx    - pulls the nginx image            (docker pull)
#   2. docker_network.app    - creates a private Docker network (docker network create)
#   3. local_file.index      - generates the web page that nginx serves
#   4. docker_container.web  - runs the container               (docker run)
# ---------------------------------------------------------------------------

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    docker = {
      source  = "kreuzwerker/docker"
      version = "~> 3.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}

# The Docker provider talks to the local Docker daemon (unix socket on Linux)
provider "docker" {
  host = var.docker_host
}

# 1. The image - same as `docker pull nginx:alpine`
resource "docker_image" "nginx" {
  name         = var.image_name
  keep_locally = true # keep the image on the machine after `terraform destroy`
}

# 2. A dedicated network - same as `docker network create`
resource "docker_network" "app" {
  name = "${var.container_name}-net"
}

# 3. The web page, generated by Terraform and mounted into the container
resource "local_file" "index" {
  filename = "${path.module}/site/index.html"
  content  = <<-EOT
    <!DOCTYPE html>
    <html lang="en">
    <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Terraform + Docker</title>
      <style>
        body { font-family: Arial, sans-serif; background: #0b1020; color: #e5e7eb;
               display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
        .card { background: #151b34; padding: 40px 56px; border-radius: 12px; text-align: center; }
        h1 { margin: 0 0 12px; color: #a78bfa; }
        .ok { color: #4ade80; font-weight: bold; }
        td { padding: 4px 14px; text-align: left; }
        td:first-child { color: #94a3b8; }
      </style>
    </head>
    <body>
      <div class="card">
        <h1>Provisioned with Terraform</h1>
        <p class="ok">This container was created by Infrastructure as Code</p>
        <table>
          <tr><td>Container</td><td>${var.container_name}</td></tr>
          <tr><td>Image</td><td>${var.image_name}</td></tr>
          <tr><td>Environment</td><td>${var.environment}</td></tr>
          <tr><td>Host port</td><td>${var.external_port}</td></tr>
        </table>
      </div>
    </body>
    </html>
  EOT
}

# 4. The container - same as `docker run -d --name ... -p 8080:80 ...`
resource "docker_container" "web" {
  name    = var.container_name
  image   = docker_image.nginx.image_id # implicit dependency on the image
  restart = "unless-stopped"
  memory  = var.memory_mb

  ports {
    internal = 80
    external = var.external_port
  }

  # Mount the generated page (implicit dependency on local_file.index)
  volumes {
    host_path      = abspath(dirname(local_file.index.filename))
    container_path = "/usr/share/nginx/html"
    read_only      = true
  }

  networks_advanced {
    name = docker_network.app.name # implicit dependency on the network
  }

  env = [
    "APP_ENV=${var.environment}",
    "APP_SECRET=${var.app_secret}", # derived from a sensitive variable
  ]

  healthcheck {
    test         = ["CMD-SHELL", "wget -q --spider http://127.0.0.1/ || exit 1"]
    interval     = "10s"
    timeout      = "3s"
    retries      = 3
    start_period = "5s"
  }

  labels {
    label = "managed_by"
    value = "terraform"
  }

  labels {
    label = "environment"
    value = var.environment
  }
}
